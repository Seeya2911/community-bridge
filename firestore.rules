rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable functions for role-based access
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    function isAdmin() {
      return hasRole('admin');
    }

    match /Users/{userId} {
      allow read: if isSignedIn(); // Allow reading for volunteers matching, etc.
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    match /Tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() 
                   || (hasRole('ngo') && (resource == null || resource.data.assigned_by == request.auth.uid || resource.data.assignedVolunteer == null || resource.data.reportedById == request.auth.uid || resource.data.ngo_id == request.auth.uid))
                   || (hasRole('volunteer') && resource != null && resource.data.assignedVolunteerId == request.auth.uid)
                   || (hasRole('field_worker'));
    }

    match /Assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() 
                   || hasRole('ngo') 
                   || (hasRole('volunteer') && resource.data.volunteer_id == request.auth.uid);
    }

    match /Notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.user_id == request.auth.uid || resource.data.volunteer_id == request.auth.uid);
      allow write: if isAdmin() || hasRole('ngo') || hasRole('volunteer') || hasRole('field_worker');
    }
  }
}
